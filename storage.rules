rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public-readable buckets — public can view any uploaded image/PDF
    // (URLs are unguessable so this is "security through obscurity" — fine for this app's threat model).
    // Writes require an authenticated user (anonymous auth counts).
    match /attachments/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /fieldnotes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /files/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /suborders/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /materials/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anything else: locked down
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
